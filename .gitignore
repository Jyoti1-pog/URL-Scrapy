.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run artefacts — never commit an operator's catalogue or images.
#
# ANCHORED with a leading slash, and it matters: an unanchored `store/` matches
# at ANY depth, so it also swallowed haat_lister/store/ and haat_lister/images/
# — two source packages. A fresh clone came up with `No module named
# haat_lister.store`. The dev checkout never noticed, because the files were
# already on disk.
/downloads/
/images/
/runs/
/store/
/listings.csv
/review.csv
/image_manifest.csv
# Observed refusals (v5 §4.4). Written by the tool, about the operator's own
# hosts, on their own network -- history rather than configuration, and it goes
# stale in thirty days. `profiles/` is deliberately NOT here: a saved column
# mapping describes the operator's catalogue and is worth versioning.
/domains.yaml
*.tmp
*.log

# The console is shipped BUILT so `serve` works without Node. If a generic
# dist/ rule ever appears above, this keeps it from silently breaking that.
!web/dist/
!web/dist/**

# Generated by demo/shop.py on first run
demo/product.jpg

# Vite's install and cache. web/dist IS committed (see above).
web/node_modules/
web/.vite/

# The delivery ZIP is a build artefact, rebuilt by tools/build_delivery.py.
/haat-lister-delivery.zip

# Generated from START-HERE.md by tools/build_docs.py. The markdown is the
# source of truth; these are rebuilt, never edited.
/START-HERE.pdf
/START-HERE.docx
