# haat-lister secrets. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and nothing in this project ever logs a value from it --
# every secret is held as a pydantic SecretStr, so an accidental repr in a
# traceback prints `SecretStr('**********')` rather than your key.
#
# Only HAAT_CONTACT is required. Everything else is needed only for the
# optional feature next to it, and `haat-lister config-check` tells you exactly
# which ones your chosen flags actually require.


# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# An email address a site operator can reach you at. It goes into the
# User-Agent of every request this tool makes:
#
#   haat-lister/0.1 (+catalogue migration for haat.ganges.world; contact: you@example.in)
#
# This is not decoration. We identify honestly and there is no fingerprint
# spoofing anywhere in this tool, so a shop that objects to being crawled needs
# a way to tell you rather than a way to block you. config-check refuses to
# pass on a placeholder address.
HAAT_CONTACT=


# ---------------------------------------------------------------------------
# IMAGE HOSTS -- only for `--images url_columns` or `--images both`
# ---------------------------------------------------------------------------
#
# Not needed at all in the default `manifest` mode, which is the right mode for
# haat: its uploader takes image FILES, not URLs. In manifest mode no image host
# is ever contacted -- there is no host object to contact.
#
# The chain is tried in the order set by `hosts.chain` in config.yaml. Configure
# as many or as few as you like; config-check names the ones it will skip.

# Cloudinary. Either the single URL form:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or the three separate values. The URL form wins if both are set.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ImgBB. https://api.imgbb.com/
IMGBB_API_KEY=

# Imgur. The Client ID from https://api.imgur.com/oauth2/addclient
# Anonymous uploads need only the Client ID, never the secret.
IMGUR_CLIENT_ID=


# ---------------------------------------------------------------------------
# LLM -- only for `--llm`
# ---------------------------------------------------------------------------
#
# Used to rewrite descriptions and suggest categories. Never used to invent a
# price, a weight, a dimension, an HS code or a GI region: those are money and
# customs fields, and a plausible-sounding guess in one of them is worse than a
# blank cell, because a blank cell is visibly a blank cell.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL -- Google Sheets export (`haat-lister master --push`)
#
# Convenience only. runs/master.csv is the deliverable; this copies it into a
# spreadsheet colleagues can see. With both of these unset the feature is
# entirely absent -- no flag, no warning.
#
# GOOGLE_CREDENTIALS_FILE is a service-account JSON key. GOOGLE_SHEET_ID is the
# id from the spreadsheet's own URL, and that spreadsheet must be SHARED with
# the service account's email address (it is in the JSON, as `client_email`).
# Needs the extra:  pip install "haat-lister[sheets]"
# ---------------------------------------------------------------------------
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=
